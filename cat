<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>互動式網頁 -  哈基米</title>
  <style>
    :root{
      --bg:#ffd6de; /* soft pink */
      --card:#ffeef2;
      --accent:#ff9eb3;
      --text:#2b2b2b;
      --muted:#6b6b6b;
      --radius:14px;
      --maxw:1000px;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: "Noto Sans TC", system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
      background:linear-gradient(180deg,var(--bg),#ffdede 60%);
      color:var(--text);
      display:flex;
      justify-content:center;
      padding:28px 14px 80px;
    }  
    .wrap{
      width:100%;
      max-width:var(--maxw);
      background:transparent;
    }
    header{background:var(--card);padding:22px;border-radius:var(--radius);text-align:center;box-shadow:0 6px 20px rgba(0,0,0,0.06);}
    h1{margin:0;font-size:44px;letter-spacing:1px}
    nav{display:flex;justify-content:center;margin:18px 0}
    nav a{margin:0 10px;color:var(--text);text-decoration:underline;cursor:pointer}

    .content{display:grid;grid-template-columns:1fr;gap:22px;margin-top:8px}
    .card{
      background:rgba(255,255,255,0.15);
      padding:18px;border-radius:12px;border:2px solid rgba(0,0,0,0.06);
    }

    .section-title{font-size:22px;margin:6px 0 12px}
    .media{
      display:flex;gap:18px;align-items:flex-start;
      flex-wrap:wrap
    }
    .img-wrap{flex:0 0 320px;padding:10px;border-radius:8px;border:4px dashed #00000070;}
    .img-wrap img{display:block;width:100%;height:auto;border-radius:6px;box-shadow:0 6px 14px rgba(0,0,0,0.15);}

    .desc{flex:1;min-width:200px;font-size:16px;color:var(--muted);line-height:1.8}

    /* hover effect: change background color of card when hovering image */
    .img-wrap:hover ~ .desc, .img-wrap:hover{transition:all .25s ease}
    .img-wrap:hover{transform:translateY(-4px);}
    .img-wrap:hover ~ .desc{background:linear-gradient(90deg,#fff0,#fff6);}

    /* interactive tabs */
    .tabs{display:flex;gap:8px;justify-content:center;margin:8px 0}
    .tabs button{background:transparent;border:2px solid transparent;padding:8px 12px;border-radius:10px;cursor:pointer}
    .tabs button.active{background:var(--accent);color:white;border-color:var(--accent)}

    footer{margin-top:18px;text-align:center;color:var(--muted);}

    /* responsive */
    @media (max-width:720px){
      h1{font-size:32px}
      .media{flex-direction:column}
      .img-wrap{flex-basis:100%}
    }
  </style>
</head>
<script>
  // 等 DOM 完全載入
  document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('.tabs button'); // 所有 tab 按鈕
    const sections = document.querySelectorAll('.content section'); // 所有內容區塊

    // 初始化：預設顯示第一個 section
    sections.forEach((sec, i) => sec.style.display = i === 0 ? 'block' : 'none');
    tabs.forEach((tab, i) => tab.classList.toggle('active', i === 0));

    // 監聽 tab 按鈕點擊
    tabs.forEach(tab => {
      tab.addEventListener('click', function () {
        const target = this.dataset.target; // 取得要顯示的 section id

        // 切換內容顯示
        sections.forEach(sec => {
          sec.style.display = sec.id === target ? 'block' : 'none';
        });

        // 切換按鈕樣式
        tabs.forEach(t => t.classList.remove('active'));
        this.classList.add('active');
      });
    });
  });
</script>
<body>
  <div class="wrap">
    <header>
      <h1>互動式網頁 — 哈基咪</h1>
    </header>
    <style>
  header h1 {
    background-color: #ffd6de; /* 原本背景色 */
    padding: 10px 20px;
    transition: background-color 0.3s; /* 漸變效果 */
    cursor: pointer; /* 滑鼠變手形 */
  }

  header h1:hover {
    background-color: #ff9eb3; /* 滑鼠移上去的新背景色 */
  }
</style>

      <div class="tabs" role="tablist">
      <button class="content" data-target="about">主頁</button>
      <button data-target="plumeria">布偶貓</button>
      <button data-target="hydrangea">緬因貓</button>
      
    </div>

    <div class="content">

      <section id="about" class="card" style="display:none;" aria-labelledby="about">
        <h2 class="section-title">布偶貓</h2>
        <div class="media">
          <div class="img-wrap" title="滑鼠移過會有些微動態效果">
            <!-- 使用上傳的本機圖片路徑 -->
            <img src="data:image/jpeg;base64," alt="布偶貓">
          </div>

          <div class="desc">
            <p><strong>簡介：</strong>布偶貓是一種體型中大型、性格溫順、親人的貓種，因被抱起時會像布娃娃一樣放鬆身體而得名。牠們通常有著夢幻的長毛、藍色的眼睛和獨特的重點色花紋，對人與其他寵物都相當友善，也因此被暱稱為「像狗一樣的貓」（Puppy cats）。</p>
          </div>
           <h2 class="section-title">緬因貓</h2>
        <div class="media">
          <div class="img-wrap">
            <!-- 若你沒有其他圖片，這裡重複使用同一張示意圖 -->
            <img src="data:image/jpeg;base64," alt="緬因貓">
          </div>

          <div class="desc">
            <p><strong>簡介：</strong>緬因貓是北美最古老的天然貓品種之一，以其「溫柔巨人」的稱號聞名，因其體型巨大、個性溫和、友善且聰明。牠們的外觀特徵包括長而蓬鬆的毛髮、大耳朵、長尾巴，以及強壯結實的體格。牠們是大型貓種，需要足夠的運動空間和活動量，並且很適合與孩子和其他寵物相處。 </p>
          </div>
      </section>

      <section id="plumeria" class="card" aria-labelledby="plumeria">
        <h2 class="section-title">布偶貓</h2>
        <div class="media">
          <div class="img-wrap" title="滑鼠移過會有些微動態效果">
            <!-- 使用上傳的本機圖片路徑 -->
            <img src="data:image/jpeg;base64," alt="布偶貓">
          </div>

          <div class="desc">
            <p><strong>簡介：</strong>布偶貓是一種體型中大型、性格溫順、親人的貓種，因被抱起時會像布娃娃一樣放鬆身體而得名。牠們通常有著夢幻的長毛、藍色的眼睛和獨特的重點色花紋，對人與其他寵物都相當友善，也因此被暱稱為「像狗一樣的貓」（Puppy cats）。</p>
          </div>
        </div>
      </section>

      <section id="hydrangea" class="card" style="display:none;" aria-labelledby="hydrangea">
        <h2 class="section-title">緬因貓</h2>
        <div class="media">
          <div class="img-wrap">
            <!-- 若你沒有其他圖片，這裡重複使用同一張示意圖 -->
            <img src="data:image/jpeg;base64," alt="緬因貓">
          </div>

          <div class="desc">
            <p><strong>簡介：</strong>緬因貓是北美最古老的天然貓品種之一，以其「溫柔巨人」的稱號聞名，因其體型巨大、個性溫和、友善且聰明。牠們的外觀特徵包括長而蓬鬆的毛髮、大耳朵、長尾巴，以及強壯結實的體格。牠們是大型貓種，需要足夠的運動空間和活動量，並且很適合與孩子和其他寵物相處。 </p>
          </div>
        </div>
      </section>

      

    

  <script>
    // tab 切換
    document.querySelectorAll('.tabs button').forEach(btn=>{
      btn.addEventListener('click',()=>{
        document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('active'));
        btn.classList.add('active');
        const target = btn.dataset.target;
        ['plumeria','hydrangea','about'].forEach(id=>{
          const el = document.getElementById(id);
          el.style.display = (id===target)?'block':'none';
        });
      });
    });

    // nav 也能控制
    document.getElementById('link-plum').addEventListener('click',()=>document.querySelector('[data-target="plumeria"]').click());
    document.getElementById('link-hydr').addEventListener('click',()=>document.querySelector('[data-target="hydrangea"]').click());
    document.getElementById('link-random').addEventListener('click',()=>randomizeTheme());

    function randomizeTheme(){
      // 隨機主色
      const hues = [330,340,10,20,300,200,150,25];
      const h = hues[Math.floor(Math.random()*hues.length)];
      document.documentElement.style.setProperty('--accent', `hsl(${h} 85% 60%)`);
      document.documentElement.style.setProperty('--card', `hsl(${h} 90% 95%)`);
      document.documentElement.style.setProperty('--bg', `linear-gradient(180deg,hsl(${h} 100% 98%), hsl(${h} 100% 96%))`);
    }
  </script>
</body>
</html>
